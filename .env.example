APP_NAME=Async Document Processing API
DEBUG=true
API_PREFIX=/api
# Local Python processes use localhost. Docker Compose overrides these URLs with
# the postgres and redis service hostnames.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/async_document_processing
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=monkey-d-luffy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
POSTGRES_DB=async_document_processing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
